rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // only authenticated users can access the contracts collection
    match /contracts/{contractId} {
      allow read, write: if request.auth != null;
      // further validation can be added here, e.g. ensure required fields exist
    }

    // users collection: each user can write their own profile
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false; // editing profile via security rules? handle in backend
    }

    // deny access to any other collections/documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
